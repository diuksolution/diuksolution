# App
AUTH_URL=http://localhost:3001
AUTH_SECRET=
CLIENT_ID=
CLIENT_SECRET=

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# AI booking — Moonshot / Kimi (preferred)
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
MOONSHOT_MODEL=kimi-k2-turbo-preview
AI_BOOKING_ENABLED=true

# Optional OpenAI fallback if MOONSHOT_API_KEY empty
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Google Calendar OAuth redirect (Cloud Console → Web client):
# ${AUTH_URL}/api/integrations/google-calendar/callback
