# App
AUTH_URL=http://localhost:3001
AUTH_SECRET=
CLIENT_ID=
CLIENT_SECRET=

# Inbox cache on Vercel: create Upstash Redis (Storage), then these are auto-set.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Optional TCP fallback:
# REDIS_URL=rediss://default:TOKEN@xxx.upstash.io:6379

# WhatsApp Cloud API credentials are per-business (Admin → Settings).
# Webhook URL for all businesses: ${AUTH_URL}/api/webhooks/whatsapp

# Midtrans payment gateway (sandbox keys for testing)
# Notification URL: ${AUTH_URL}/api/webhooks/midtrans
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# AI booking — OpenAI is used when OPENAI_API_KEY is set
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Moonshot / Kimi fallback if OPENAI_API_KEY empty
# MOONSHOT_API_KEY=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k2-turbo-preview
AI_BOOKING_ENABLED=true

# Google Calendar OAuth redirect (Cloud Console → Web client):
# ${AUTH_URL}/api/integrations/google-calendar/callback
