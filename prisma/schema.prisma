generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum AuthProvider {
  GOOGLE
  CREDENTIALS
}

enum BusinessType {
  CLINIC
  FNB
  BARBERSHOP
  GYM
  TOURISM
  OTHER
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageDeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ContactLifecycle {
  NEW_LEAD
  CONTACTED
  INTERESTED
  BOOKED
  CUSTOMER
  RETURNING
  INACTIVE
  LOST
}

enum LeadSource {
  WHATSAPP
  INSTAGRAM
  WEBSITE
  REFERRAL
  OTHER
}

enum ContactGender {
  FEMALE
  MALE
  OTHER
  UNSPECIFIED
}

enum FollowUpType {
  BOOKING
  REMINDER
  POST_SERVICE
  PROMO
  UNREPLIED
  NO_BOOKING
  CUSTOM
}

enum FollowUpStatus {
  PENDING
  DONE
  SKIPPED
}

enum CrmBookingStatus {
  BOOKED
  CANCELLED
  DP
  PAID
  DONE
}

enum PaymentKind {
  DP
  FULL
}

enum PaymentStatus {
  PENDING
  SETTLEMENT
  EXPIRE
  CANCEL
  FAILURE
}

enum PaymentChannel {
  SNAP
  QRIS
}

model Business {
  id              String           @id @default(cuid())
  name            String
  businessType    BusinessType
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  users           User[]
  whatsAppNumbers WhatsAppNumber[]
  contacts        Contact[]
  conversations   Conversation[]
  tags            Tag[]
  crmBookings     CrmBooking[]
  practitioners   Practitioner[]
  daySchedules    PractitionerDaySchedule[]
  services        Service[]
  payments        Payment[]
  aiAutomation    AiAutomationSettings?
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  username     String?       @unique
  password     String?
  name         String?
  image        String?
  googleId     String?       @unique
  authProvider AuthProvider
  role         Role          @default(STAFF)
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([businessId])
}

model WhatsAppNumber {
  id              String   @id @default(cuid())
  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  phoneNumberId   String   @unique
  displayNumber   String?
  wabaId          String?
  /// Encrypted Meta permanent/system user token for this number
  accessTokenEnc  String?  @db.Text
  /// Encrypted Meta app secret (webhook signature) for this number's app
  appSecretEnc    String?  @db.Text
  /// Encrypted webhook verify token for this number's app
  verifyTokenEnc  String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId])
}

model AiAutomationSettings {
  id                  String   @id @default(cuid())
  businessId          String   @unique
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  enabled             Boolean  @default(true)
  welcomeEnabled      Boolean  @default(true)
  welcomeMessage      String   @db.Text
  bookingSystemPrompt String   @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Practitioner {
  id                   String    @id @default(cuid())
  businessId           String
  business             Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name                 String
  title                String?
  specialty            String?
  email                String?
  phone                String?
  location             String?
  bio                  String?
  isActive             Boolean   @default(true)
  timezone             String    @default("Asia/Jakarta")
  /// UI accent: primary | secondary | success
  tone                 String    @default("primary")
  /// Google Calendar connection (filled after OAuth)
  googleAccountEmail   String?
  googleCalendarId     String?
  googleRefreshToken   String?
  googleAccessToken    String?
  googleTokenExpiresAt DateTime?
  googleConnectedAt    DateTime?
  calendarSyncEnabled  Boolean   @default(false)
  bookings             CrmBooking[]
  daySchedules         PractitionerDaySchedule[]
  services             PractitionerService[]
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([businessId, isActive])
  @@index([businessId, name])
}

model PractitionerDaySchedule {
  id             String       @id @default(cuid())
  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  /// Calendar date (store as noon UTC to avoid TZ edge cases)
  date           DateTime     @db.Date
  startTime      String       @default("09:00")
  endTime        String       @default("17:00")
  /// Doctor unavailable / berhalangan hadir for this date
  isOff          Boolean      @default(false)
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([practitionerId, date])
  @@index([businessId, date])
  @@index([practitionerId, date])
}

/// Catalog of billable treatments / packages per business (price source for AI + payments)
model Service {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  /// Full price in IDR (rupiah, no decimals)
  price       Int
  /// Down-payment amount in IDR; 0 = DP not offered
  dpAmount    Int      @default(0)
  /// Optional estimated duration in minutes
  durationMin Int?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  practitioners PractitionerService[]
  bookings      CrmBooking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId, isActive])
  @@index([businessId, sortOrder])
}

/// Which practitioners may perform which catalog services (AI + booking source of truth)
model PractitionerService {
  practitionerId String
  serviceId      String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  service        Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@id([practitionerId, serviceId])
  @@index([serviceId])
}

model Contact {
  id              String           @id @default(cuid())
  businessId      String
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  waId            String
  name            String?
  email           String?
  gender          ContactGender    @default(UNSPECIFIED)
  birthDate       DateTime?
  source          LeadSource       @default(WHATSAPP)
  lifecycle       ContactLifecycle @default(NEW_LEAD)
  assignedStaff   String?
  potentialValue  Int?
  nextFollowUpAt  DateTime?
  conversations   Conversation[]
  tags            ContactTag[]
  notes           ContactNote[]
  followUps       ContactFollowUp[]
  bookings        CrmBooking[]
  payments        Payment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([businessId, waId])
  @@index([businessId])
  @@index([businessId, lifecycle])
  @@index([businessId, nextFollowUpAt])
}

model Tag {
  id         String       @id @default(cuid())
  businessId String
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  color      String       @default("primary")
  contacts   ContactTag[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
}

model ContactTag {
  contactId String
  tagId     String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([contactId, tagId])
  @@index([tagId])
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  authorName String?
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId, createdAt])
}

model ContactFollowUp {
  id          String         @id @default(cuid())
  contactId   String
  contact     Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  type        FollowUpType   @default(CUSTOM)
  status      FollowUpStatus @default(PENDING)
  dueAt       DateTime
  note        String?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([contactId, dueAt])
  @@index([status, dueAt])
}

model CrmBooking {
  id             String           @id @default(cuid())
  businessId     String
  business       Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId      String
  contact        Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  practitionerId String?
  practitioner   Practitioner?    @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  serviceId      String?
  catalogService Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  service        String
  staffName      String?
  status         CrmBookingStatus @default(BOOKED)
  amount         Int              @default(0)
  scheduledAt    DateTime
  completedAt    DateTime?
  googleEventId  String?
  notes          String?
  payments       Payment[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([businessId, scheduledAt])
  @@index([contactId, scheduledAt])
  @@index([practitionerId, scheduledAt])
  @@index([serviceId])
}

model Payment {
  id                    String         @id @default(cuid())
  businessId            String
  business              Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  bookingId             String
  booking               CrmBooking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  contactId             String?
  contact               Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  /// Midtrans order_id (unique)
  orderId               String         @unique
  kind                  PaymentKind
  channel               PaymentChannel
  amount                Int
  status                PaymentStatus  @default(PENDING)
  snapToken             String?
  redirectUrl           String?
  qrisUrl               String?
  midtransTransactionId String?
  paidAt                DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([businessId, status])
  @@index([bookingId, status])
  @@index([contactId])
}

model Conversation {
  id            String    @id @default(cuid())
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contactId     String
  contact       Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel       String    @default("whatsapp")
  lastMessageAt DateTime  @default(now())
  lastPreview   String    @default("")
  unreadCount   Int       @default(0)
  /// Per-conversation AI auto-reply switch (chat header toggle)
  aiEnabled     Boolean   @default(true)
  messages      Message[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([businessId, contactId, channel])
  @@index([businessId, lastMessageAt])
}

model Message {
  id             String                @id @default(cuid())
  conversationId String
  conversation   Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  waMessageId    String?               @unique
  direction      MessageDirection
  type           String                @default("text")
  text           String?
  status         MessageDeliveryStatus @default(SENT)
  sentAt         DateTime
  createdAt      DateTime              @default(now())

  @@index([conversationId, sentAt])
}
